# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.gstack/
!.env.example

# local database, WAL side files and backups — real money data never goes in git
/prisma/*.db
/prisma/*.db-*
/prisma/*.bak
/backups

# design exports and agent/tooling folders
/.design-reference
/Poker tracker with PKRTrackr features
*.zip
/.agents
/.windsurf
skills-lock.json

# Prisma CLI agent skill docs (tooling, not app code)
/.claude/skills
