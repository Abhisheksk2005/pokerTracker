# Copy to .env (local) or set in your host's environment (production).

# Database.
# - Local dev: a SQLite file (relative paths resolve from the project root).
# - Vercel:    your Turso database URL, e.g. libsql://pkrtrackr-yourname.turso.io
# - Docker:    set to file:/data/pkrtrackr.db on a persistent volume.
DATABASE_URL="file:./prisma/dev.db"

# Turso auth token (only needed for a libsql:// URL). Create one with:
#   turso db tokens create <database-name>
# DATABASE_AUTH_TOKEN=""

# Shared passcode your group types to open the app. REQUIRED in production:
# a production build without it shows a setup screen and refuses all access.
APP_PASSCODE=""

# Long random string used to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it (or APP_PASSCODE) signs every device out.
AUTH_SECRET=""

# Only for a private network you fully trust: run production with no passcode.
# ALLOW_OPEN_ACCESS="true"

# Only if you serve production over plain HTTP (e.g. LAN testing). Session
# cookies are Secure by default and browsers drop them over http://.
# INSECURE_COOKIES="true"

# Backups (npm run db:backup)
# BACKUP_DIR="./backups"
# BACKUP_KEEP="14"
